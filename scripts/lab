#!/usr/bin/env bash
# One entry point for the offline lab.
#
#   ./scripts/lab run --games 5000000      start or resume a sharded run
#   ./scripts/lab run --dry-run            show the shard plan without starting
#   ./scripts/lab status <run-id>          progress, with every shard verified
#   ./scripts/lab list                     all runs under lab/data/runs
#   ./scripts/lab stop <run-id>            ask this lab's runner to stop safely
#   ./scripts/lab doctor                   check harness, store, locks and probes
#   ./scripts/lab clean --probes --yes     reclaim probe data; --stale-locks too
#   ./scripts/lab merge <run-id>           one CSV from the finished shards
#   ./scripts/lab report <run-id>          plain-language README for a run
#   ./scripts/lab evaluate --input X.csv   calibration report on a CSV
#   ./scripts/lab cloud plan               plan private Kaggle sessions
#   ./scripts/lab cloud verify <run-id>    re-check downloaded cloud artifacts
#   ./scripts/lab build                    build the C++ self-play harness
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/lab/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

command="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$command" in
  run|status|list|stop|doctor|clean|merge)
    exec python3 -m isolyn_lab.runner "$command" "$@"
    ;;
  report)
    exec python3 -m isolyn_lab.report "$@"
    ;;
  evaluate)
    exec python3 -m isolyn_lab.cli evaluate "$@"
    ;;
  cloud)
    exec python3 -m isolyn_lab.cloud "$@"
    ;;
  build)
    exec "$ROOT/tools/selfplay/build.sh"
    ;;
  help|--help|-h)
    sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "unknown lab command: $command" >&2
    echo "try: ./scripts/lab help" >&2
    exit 2
    ;;
esac
