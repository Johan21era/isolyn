#!/bin/bash
# IsolynV2.0 quick launch: rebuild the current tree and open the newest app.
# Target of the `iso`, `ISO`, `Iso`, and `isolyn` shell aliases.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# `open` on an already-running app only activates the old process. Quit it
# first so every invocation actually runs the freshly built binary.
if pgrep -x IsolynV2.0 >/dev/null 2>&1; then
  echo "♻️  Closing the running IsolynV2.0 so the new build can launch…"
  pkill -TERM -x IsolynV2.0 2>/dev/null || true
  for _ in {1..50}; do
    pgrep -x IsolynV2.0 >/dev/null 2>&1 || break
    sleep 0.1
  done
  if pgrep -x IsolynV2.0 >/dev/null 2>&1; then
    echo "⚠️  IsolynV2.0 ignored SIGTERM; forcing it closed."
    pkill -KILL -x IsolynV2.0 2>/dev/null || true
    sleep 0.3
  fi
fi

exec "$ROOT/run.sh" "$@"
